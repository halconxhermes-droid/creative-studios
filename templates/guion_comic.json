{
  "$schema": "guion_comic_v1",
  "obra": "<título>",
  "autor": "<escritor original>",
  "guionista": "<agente-guionista>",
  "fecha": "<YYYY-MM-DD>",
  "formato": "comic",
  "paginas_total": 8,
  "estilo_visual": {
    "paleta_por_escena": {
      "escena_normal": ["#hex1", "#hex2"],
      "escena_accion": ["#hex1", "#hex2"],
      "escena_emotiva": ["#hex1", "#hex2"]
    },
    "tipografia": "fuente",
    "referencias": ["obra1", "obra2"]
  },
  "paginas": [
    {
      "numero": 1,
      "tipo_pagina": "splash | viñetas | mixta",
      "viñetas": [
        {
          "numero": 1,
          "tamano": "splash | full | half | quarter | inset",
          "descripcion_visual": "<descripción detallada>",
          "dialogo": [
            {
              "personaje": "<nombre>",
              "texto": "<línea>",
              "tipo": "caption | balloon | thought | whisper | shout"
            }
          ],
          "ef": "<efecto de sonido>",
          "paleta_escena": "<qué paleta usar>",
          "notas_director_arte": "<instrucciones de color>"
        }
      ]
    }
  ]
}
